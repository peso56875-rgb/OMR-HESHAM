# انسخ هذا الملف إلى .env واملأ القيم. لا تضع الملف الحقيقي في Git.

# ─── Firebase Admin (مطلوب) ───────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# ضع المفتاح بين علامتي تنصيص واستخدم \n للأسطر الجديدة
FIREBASE_PRIVATE_KEY=""

# ─── Firebase Web (اختياري: للواجهة) ──────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ─── تخزين الصور ──────────────────────────────────────────────────────────
# 1) Cloudinary — الطبقة الأساسية للرفع (موصى بها)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# المجلد الذي تُرفع فيه الملفات داخل Cloudinary (افتراضي: omar-hesham)
CLOUDINARY_FOLDER=omar-hesham

# 2) Firebase Storage — يُستخدم فقط إذا كانت الحزمة مُفعّلة فعلاً في المشروع
#    (فعّل Storage من Firebase Console أولاً، وإلا سيتم تخطيه تلقائيًا)
FIREBASE_STORAGE_BUCKET=

# 3) Firestore — طبقة احتياطية تعمل تلقائيًا بدون أي إعداد (حد ~5 ميجابايت)

# ─── الإشعارات البريدية (Resend) ───────────────────────────────────────────
# نظام الإشعارات يستخدم Resend عبر HTTP API مباشرة (بدون حزم npm إضافية).
# لو تُركت RESEND_API_KEY فاضية، الموقع يعمل طبيعي تمامًا ويتم تخطي البريد
# بصمت (يُسجّل سبب التخطي في اللوج فقط) — وهذه حالة طبيعية وليست خطأ.
RESEND_API_KEY=
# المُرسِل. لازم يكون على دومين موثّق في Resend.
# للتجربة يمكن استخدام: onboarding@resend.dev
EMAIL_FROM=مؤسسة الدكتور عمر هشام <onboarding@resend.dev>
# بريد الإدارة الذي يستقبل تنبيهات التبرعات/التواصل/التطوع/التوظيف.
# لو فاضي، يتم تخطي رسائل الإدارة فقط بينما تصل رسائل المستخدمين عاديًا.
ADMIN_EMAIL=

# ─── إيصالات التبرع ────────────────────────────────────────────────────────
# سر توقيع روابط الإيصالات (HMAC-SHA256).
#
# أرقام الإيصالات تسلسلية (REC-2026-000001) وبالتالي قابلة للتخمين، فلولا
# التوقيع لأمكن لأي شخص المرور على الأرقام وقراءة اسم كل متبرع وهاتفه ومبلغه.
#
# لو تُرك فاضيًا يُشتق السر من FIREBASE_PRIVATE_KEY تلقائيًا، وهذا يعمل لكن
# الأفضل تعيين قيمة مستقلة: تغيير مفتاح Firebase مستقبلًا سيُبطل كل الروابط
# الصادرة، بينما السر المستقل يفصل الأمرين.
#
# للتوليد:  openssl rand -hex 32
#
# ⚠️ تنبيه: تغيير هذه القيمة بعد إصدار إيصالات يُبطل روابط التحقق القديمة
#    (الإيصالات نفسها تبقى في قاعدة البيانات، لكن روابطها لن تعمل).
RECEIPT_SECRET=
